@using Domain.Entities;
@model Tuple<List<Product>, string>

<!-- products content -->
<div class="container" data-aos="fade-up" id="p-container"
     data-aos-duration="1500">
    <h1 class="text-center" id="product-h1">@Model.Item2</h1>
    <br>
  
    <div id="product">
        @if (Model.Item1.Count == 0)
        {   
            <div>
                <p>No products found.</p> 
            </div>
        }

        @foreach (var product in Model.Item1)
        {
            string modalLink = product.Id + "-modal";
            <div class="product-box">
                <div class="product-img">
                    <a href="/Products/ViewProduct/@product.Id">
                        <img src="@product.Image" alt="No preview available" class="img-responsive">
                    </a>
                </div>
                <div class="product-desc">
                    <h4>@product.Name</h4>
                    <p class="desc">@product.Brand</p>
                    <p class="price">Rs. @product.Price</p>
                    <br style="clear: both;">
                    <br>
                    <input type="hidden" id="quantity" value="1" />
                    <button type="button" onclick="addToCart(this)" data-product-id="@product.Id" class="btn btn-secondary">Add to Cart</button>
                    <br>
                    <br style="clear: both;">
                </div>
            </div>
        }
    </div>
</div>
<!-- products content -->





