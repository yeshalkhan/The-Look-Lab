@using Domain.Entities
@model User
@using Newtonsoft.Json
@{
    ViewBag.Title = "Profile - The Look Lab";
}

<div class="container" data-aos="fade-up" data-aos-duration="1500" id="profile">
    <h1 class="text-center">MY PROFILE</h1>
    <br>
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-6">
            <h3>Name: </h3><p>@Model.Name</p>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-6">
            <h3>Email: </h3><p>@Model.Email</p>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-6">
            <div class="text-center">
                <a class="btn btn-secondary" href="@Url.Action("EditProfile", "User")">Edit Profile</a>
            </div>
        </div>
    </div>
    <div class="row justify-content-center mt-3">
        <div class="col-lg-5 col-md-6">
            <div class="text-center">
                <a class="btn btn-secondary" href="@Url.Action("OrderHistory", "User")">View Order History</a>
            </div>
        </div>
    </div>
    <div class="row justify-content-center mt-3">
        <div class="col-lg-5 col-md-6">
            <div class="text-center">
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="btn btn-secondary">Logout</button>
                </form>
            </div>
        </div>
    </div>
    <br>
</div>

